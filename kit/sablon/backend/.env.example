# Bu dosya commit edilir; GERÇEK DEĞER YAZMA. Kopyala: cp .env.example .env
# Tüm değerler app/config.py (pydantic-settings) üzerinden okunur.

ENV=development                     # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/app
CORS_ORIGINS=http://localhost:3000  # virgülle ayır, * kullanma

JWT_SECRET=
JWT_ISSUER=

SENTRY_DSN=
HEALTHCHECKS_PING_URL=              # cron işleri için

# AI (kullanılıyorsa)
ANTHROPIC_API_KEY=
