{
  "permissions": {
    "allow": [
      "Bash(npx expo lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run test:*)",
      "Bash(npx expo-doctor)",
      "Bash(npm outdated)",
      "Bash(npm audit)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
