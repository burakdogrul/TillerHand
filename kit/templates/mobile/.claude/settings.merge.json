{
  "permissions": {
    "allow": [
      "Bash(npx expo lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run test:*)",
      "Bash(npx expo-doctor)",
      "Bash(npm outdated)",
      "Bash(npm audit)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "expo-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/expo/skills.git"
      }
    },
    "supabase-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/supabase/agent-skills.git"
      }
    }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "expo@expo-plugins": true,
    "supabase@supabase-agent-skills": true,
    "postgres-best-practices@supabase-agent-skills": true
  }
}
