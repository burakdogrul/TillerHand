# Bu dosya commit edilir; GERÇEK DEĞER YAZMA. Kopyala: cp .env.example .env
# Yerel değerler sadece GELİŞTİRME (dev) projesinden gelir. Prod değerleri sadece EAS ortam değişkenlerinde durur; bu makineye ve AI ortamına girmez.
# EXPO_PUBLIC_ ile başlayanlar uygulama paketine gömülür = herkese açık.
# Gizli anahtar gerektiren her işlem sunucuda (Supabase Edge Function / backend) yapılır.

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_… (gizli anahtar uygulamaya girmez)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Sadece build/EAS tarafında (pakete girmez; EAS Secrets'a da ekle)
SENTRY_AUTH_TOKEN=
