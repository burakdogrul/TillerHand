# This file is committed; DO NOT WRITE REAL VALUES. Copy: cp .env.example .env
# Local values come only from the DEVELOPMENT (dev) project. Production values live only in EAS environment variables; they never reach this machine or the AI environment.
# Variables starting with EXPO_PUBLIC_ are embedded in the app bundle = public.
# Anything that needs a secret key runs on the server (Supabase Edge Function / backend).

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_… (the secret key never goes into the app)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Build/EAS side only (not bundled in the app; add to EAS Secrets too)
SENTRY_AUTH_TOKEN=
