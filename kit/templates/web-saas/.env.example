# Bu dosya commit edilir; GERÇEK DEĞER YAZMA. Kopyala: cp .env.example .env.local
# Yerel değerler sadece GELİŞTİRME (dev) projesinden gelir. Prod değerleri sadece Vercel > Settings > Environment Variables'ta durur; bu makineye ve AI ortamına girmez.
# NEXT_PUBLIC_ ile başlayanlar tarayıcıya gider. Sır asla NEXT_PUBLIC_ olmaz.

# Uygulama
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Panel > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_…
SUPABASE_SECRET_KEY=                    # sb_secret_…, sadece sunucu, RLS'i atlar

# Ödeme
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# E-posta
RESEND_API_KEY=

# Hata takibi
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                  # sadece build sırasında (source map)

# AI (kullanılıyorsa)
ANTHROPIC_API_KEY=
