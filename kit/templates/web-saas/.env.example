# This file is committed; DO NOT WRITE REAL VALUES. Copy: cp .env.example .env.local
# Local values come only from the DEVELOPMENT (dev) project. Prod values live only in Vercel > Settings > Environment Variables; they never enter this machine or the AI environment.
# Variables starting with NEXT_PUBLIC_ go to the browser. A secret is never NEXT_PUBLIC_.

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_…
SUPABASE_SECRET_KEY=                    # sb_secret_…, server only, bypasses RLS

# Payment
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email
RESEND_API_KEY=

# Error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                  # only during build (source map)

# AI (if used)
ANTHROPIC_API_KEY=
