# This file is committed; DO NOT WRITE REAL VALUES. Copy: cp .env.example .env
# Local values come only from the DEVELOPMENT (dev) environment. Prod values live only in the hosting panel; they never enter this machine or the AI environment.
# All values are read through app/config.py (pydantic-settings).

ENV=development                     # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/app
CORS_ORIGINS=http://localhost:3000  # separate with commas, do not use *

JWT_SECRET=
JWT_ISSUER=

SENTRY_DSN=
HEALTHCHECKS_PING_URL=              # for cron jobs

# AI (if used)
ANTHROPIC_API_KEY=
