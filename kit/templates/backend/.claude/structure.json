{
  "description": "Backend (FastAPI, özellik bazlı). Yeni dosyalar sadece bu kalıplara uyan yerlere yazılır; değiştirmek teknik bir karardır. Ayrıntı: docs/architecture/structure.md",
  "allow": [
    "README.md",
    "CHANGELOG.md",
    "CLAUDE.md",
    "DESIGN.md",
    "PRODUCT.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    ".env.example",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    ".mcp.json",
    ".kit.json",
    "docs/**",
    ".claude/**",
    ".github/**",
    "scripts/*",
    "ai/**",
    ".previews/**",
    "pyproject.toml",
    "uv.lock",
    ".python-version",
    "Dockerfile",
    ".dockerignore",
    "docker-compose.yml",
    "alembic.ini",
    ".pre-commit-config.yaml",
    "app/__init__.py",
    "app/main.py",
    "app/config.py",
    "app/core/**",
    "app/shared/**",
    "app/jobs/**",
    "app/features/__init__.py",
    "app/features/*/__init__.py",
    "app/features/*/router.py",
    "app/features/*/service.py",
    "app/features/*/models.py",
    "app/features/*/schemas.py",
    "app/features/*/repository.py",
    "app/features/*/dependencies.py",
    "app/features/*/exceptions.py",
    "app/features/*/constants.py",
    "alembic/**",
    "tests/**"
  ],
  "deny": [
    "**/*.bak",
    "**/*.orig",
    "**/*.tmp",
    "**/*~",
    "**/*-old.*",
    "**/*_old.*",
    "**/* copy*",
    "**/*kopya*",
    "**/*-yedek*",
    "**/*.backup",
    "**/temp/**",
    "**/tmp/**",
    "**/untitled*",
    "**/test.*",
    "**/deneme*"
  ]
}
