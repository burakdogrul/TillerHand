{
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uv tree --outdated:*)",
      "Bash(uv run --with pip-audit pip-audit:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "impeccable@impeccable": false,
    "taste-skill@taste-skill": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "pyright-lsp@claude-plugins-official": true,
    "postgres-best-practices@supabase-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "supabase-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/supabase/agent-skills.git"
      }
    }
  }
}
