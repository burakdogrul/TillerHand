{
  "kit-session": {
    "SessionStart": [
      { "type": "command", "command": "node .claude/hooks/session-start.mjs" }
    ]
  },
  "kit-file-guards": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-secrets.mjs" },
          { "type": "command", "command": "node .claude/hooks/freeze-guard.mjs" },
          { "type": "command", "command": "node .claude/hooks/structure-guard.mjs" },
          { "type": "command", "command": "node .claude/hooks/test-guard.mjs" },
          { "type": "command", "command": "node .claude/hooks/package-gate.mjs", "timeout": 30 }
        ]
      }
    ]
  },
  "kit-edit-rounds": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/edit-rounds.mjs" }
        ]
      }
    ],
    "PreInvocation": [
      { "type": "command", "command": "node .claude/hooks/edit-rounds.mjs --inject" }
    ]
  },
  "kit-read-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/freeze-guard.mjs" }
        ]
      }
    ]
  },
  "kit-command-guards": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-secrets.mjs" },
          { "type": "command", "command": "node .claude/hooks/destructive-guard.mjs" },
          { "type": "command", "command": "node .claude/hooks/package-gate.mjs", "timeout": 30 }
        ]
      }
    ]
  }
}
